# <app> — production environment.
# Copy to `.env` beside docker-compose.yml on orb, fill in, then `chmod 600 .env`.
# Never commit the real file.

# ── Required ─────────────────────────────────────────────────────────────────
# The app refuses to start without this. Generate with:
API_KEY=

# ── Overrides (compose already sets sensible values) ─────────────────────────
# PORT=3000
# TZ=America/Toronto